datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}











model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String @default("CLIENT")
  phone     String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientProfile     Client?
  supervisorProfile Supervisor?
  sentMessages      Message[]      @relation("SentMessages")
  receivedMessages  Message[]      @relation("ReceivedMessages")
  notifications     Notification[]
}

model Client {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
  projectId  Int
  clientCode String   @unique // e.g. ACV-2345
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payments   Payment[]
  requests   Request[]
  siteVisits SiteVisit[]
  qrCode     QRCode?
}

model Supervisor {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]
}

model Project {
  id                   Int           @id @default(autoincrement())
  name                 String
  tagline              String?
  location             String
  mapQuery             String?
  builder              String        @default("Arthi Constructions")
  type                 String // e.g. Luxury Villas, Premium Apartments
  status               String @default("ONGOING")
  startingPrice        String
  priceNote            String?
  towers               Int?          @default(0)
  villas               Int?          @default(0)
  flats                Int?          @default(0)
  floors               Int
  totalUnits           Int
  unitsAvailable       Int
  unitsBooked          Int
  amenities            String // Array of strings
  expectedCompletion   String
  constructionProgress Int           @default(0)
  reraNo               String?
  hero                 String? // Hero image URL
  salesContactName     String?
  salesContactPhone    String?
  salesContactEmail    String?
  description          String        
  specifications       String? // JSON payload of specifications key-values
  faqs                 String? // JSON payload of FAQs array [{q, a}]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  supervisorId Int?
  supervisor   Supervisor? @relation(fields: [supervisorId], references: [id], onDelete: SetNull)
  clients      Client[]

  constructionUpdates ConstructionUpdate[]
  gallery             GalleryItem[]
  documents           Document[]
  payments            Payment[]
  requests            Request[]
  siteVisits          SiteVisit[]
  messages            Message[]
  qrCodes             QRCode[]
}

model ConstructionUpdate {
  id         Int      @id @default(autoincrement())
  projectId  Int
  stage      String
  percentage Int
  date       DateTime @default(now())
  note       String?  
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model GalleryItem {
  id          Int      @id @default(autoincrement())
  projectId   Int
  url         String
  caption     String?
  type        String   @default("image") // image or video
  uploadedBy  String   @default("Supervisor")
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Document {
  id         Int      @id @default(autoincrement())
  projectId  Int
  name       String
  url        String
  type       String // e.g. Agreement, Blueprint, Bill, Receipt
  uploadedBy String   @default("Supervisor")
  date       DateTime @default(now())
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Payment {
  id          Int           @id @default(autoincrement())
  projectId   Int
  clientId    Int
  description String
  amount      Float
  status      String @default("DUE")
  due         DateTime?
  method      String? // NEFT, Cheque, UPI, etc.
  date        DateTime? // Payment date if paid
  createdAt   DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Request {
  id          Int           @id @default(autoincrement())
  projectId   Int
  clientId    Int
  category    String // Kitchen, Electrical, Interior, Painting, Plumbing, Other
  title       String
  description String?       
  status      String @default("PENDING")
  reply       String?       
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model SiteVisit {
  id        Int         @id @default(autoincrement())
  projectId Int
  clientId  Int
  date      DateTime
  time      String
  visitors  String
  notes     String?     
  status    String @default("PENDING")
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Message {
  id         Int      @id @default(autoincrement())
  projectId  Int
  senderId   Int
  receiverId Int
  content    String   
  type       String   @default("text") // text, image, file
  timestamp  DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sender   User    @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User    @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  body      String
  read      Boolean  @default(false)
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QRCode {
  id        Int      @id @default(autoincrement())
  clientId  Int      @unique
  projectId Int
  code      String   @unique // The unique scanned string
  url       String? // Cloudinary image URL of the QR code
  createdAt DateTime @default(now())

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
